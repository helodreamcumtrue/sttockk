# MarketPulse Intelligence — Environment Configuration Example
# Copy this file to .env for local development or set in Vercel / Cloud environment

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Default: file:marketpulse.db (zero-config SQLite using @libsql/client)
# For Neon PostgreSQL (Free Tier):
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=file:marketpulse.db

# -----------------------------------------------------------------------------
# APPLICATION RUNTIME MODE
# -----------------------------------------------------------------------------
# Set to 'true' to force Demo / Synthetic mode across all users
# Set to 'false' to enable live news ingestion and live delayed market quotes
FORCE_DEMO_MODE=false

# -----------------------------------------------------------------------------
# FREE MARKET DATA PROVIDERS (OPTIONAL)
# -----------------------------------------------------------------------------
# Alpha Vantage (Optional Free Tier: 25 requests/day, 5 requests/minute)
# Get a free key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Note: Yahoo Finance adapter uses public endpoints for delayed NSE quotes
# and does NOT require an API key.

# -----------------------------------------------------------------------------
# NEWS INGESTION SETTINGS
# -----------------------------------------------------------------------------
# Ingestion poll interval in minutes (default 30 min to respect free source terms)
NEWS_INGESTION_INTERVAL_MINUTES=30
# Max articles processed per cycle
MAX_ARTICLES_PER_RUN=50
